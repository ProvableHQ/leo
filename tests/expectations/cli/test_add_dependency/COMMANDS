#!/usr/bin/env bash

LEO_BIN=${1}

cd my_program || exit 1

echo "--- 1. leo add with no source flag (should fail) ---" | tee /dev/stderr
${LEO_BIN} add some_dep
echo "no source exit code: $?"
cat program.json

echo "--- 2. leo add with multiple flags (should fail) ---" | tee /dev/stderr
${LEO_BIN} add some_dep --network --local ../some_path
echo "multiple flags exit code: $?"
cat program.json

echo "--- 3. leo add --network (should succeed) ---" | tee /dev/stderr
${LEO_BIN} add --network credits --trust-endpoint --endpoint http://localhost:${LEO_DEVNODE_PORT:-3030}
cat program.json

echo "--- 4. leo add --local (should succeed) ---" | tee /dev/stderr
${LEO_BIN} add some_local --local ../some_local
cat program.json

echo "--- 5. leo add --local (should succeed) ---" | tee /dev/stderr
${LEO_BIN} add my_lib --local ../my_lib
cat program.json

echo "--- 6. leo add overwrite existing dep (should succeed) ---" | tee /dev/stderr
${LEO_BIN} add credits --local ../credits
cat program.json

echo "--- 7. leo add --dev for a program not on the network (should fail) ---" | tee /dev/stderr
${LEO_BIN} add --dev --network dev_dep --trust-endpoint --endpoint http://localhost:${LEO_DEVNODE_PORT:-3030}
echo "missing network dep exit code: $?"
cat program.json

echo "--- 8. leo add --dev for a program on the network (should succeed) ---" | tee /dev/stderr
${LEO_BIN} add --dev --network credits --trust-endpoint --endpoint http://localhost:${LEO_DEVNODE_PORT:-3030}
echo "network dev dep exit code: $?"
cat program.json

echo "--- 9. leo remove library dep by bare name (should succeed) ---" | tee /dev/stderr
${LEO_BIN} remove my_lib
cat program.json

echo "--- 10. leo remove program dep by bare name (should succeed) ---" | tee /dev/stderr
${LEO_BIN} remove some_local
cat program.json

echo "--- 11. leo remove non-existent dep (should fail) ---" | tee /dev/stderr
${LEO_BIN} remove nonexistent || true
