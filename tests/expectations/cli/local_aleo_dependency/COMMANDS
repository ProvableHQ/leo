#!/usr/bin/env bash

LEO_BIN=${1}

${LEO_BIN} --disable-update-check build

probe=$(mktemp -d)
cp program.json "$probe/program.json"
cp -R build "$probe/build"
trap 'cp "$probe/program.json" program.json; cp "$probe/build/complex/complex.aleo" build/complex/complex.aleo; rm -f tests leo.lock escaped.aleo; rm -rf escaped "$probe"' EXIT
mkdir "$probe/tests"
printf 'program test_external.aleo {}\n' > "$probe/tests/test_external.leo"
ln -s "$probe/tests" tests
if output=$(${LEO_BIN} --disable-update-check build --build-tests 2>&1); then
    echo "Build accepted a linked tests directory"
    exit 1
fi
[[ "$output" == *"expected a test directory, not a symlink"* ]] || { echo "$output"; exit 1; }
diff -r "$probe/build" build || exit 1
rm tests
echo "Rejected linked tests directory; build artifacts are unchanged."
printf '{"version":1,"git":[]}\n' > "$probe/lock-target"
cp "$probe/lock-target" "$probe/lock-original"
ln -s "$probe/lock-target" leo.lock
if output=$(${LEO_BIN} --disable-update-check build 2>&1); then
    echo "Build accepted a linked lock file"
    exit 1
fi
[[ "$output" == *"expected a regular file, not a symlink"* ]] || { echo "$output"; exit 1; }
[[ -L leo.lock ]] || exit 1
cmp "$probe/lock-original" "$probe/lock-target" || exit 1
diff -r "$probe/build" build || exit 1
rm leo.lock
echo "Rejected linked lock during build; target and build artifacts are unchanged."

mkdir -p "$probe/bridge/src"
printf '// library\n' > "$probe/bridge/src/lib.leo"
sed 's/program simple.aleo;/program complex.aleo;/' simple.aleo > "$probe/complex-dependency.aleo"
printf '{"program":"bridge","version":"0.1.0","description":"","license":"MIT","dependencies":[{"name":"complex","location":"local","path":"../complex-dependency.aleo"}]}\n' > "$probe/bridge/program.json"
printf '{"program":"complex.aleo","version":"0.1.0","description":"","license":"MIT","dependencies":[{"name":"simple.aleo","location":"local","path":"simple.aleo"},{"name":"bridge","location":"local","path":"%s/bridge"}]}\n' "$probe" > program.json
printf 'primary artifact sentinel\n' > build/complex/complex.aleo
if output=$(${LEO_BIN} --disable-update-check build 2>&1); then
    echo "Build accepted a transitive primary alias"
    exit 1
fi
[[ "$output" == *"conflicting dependency"* ]] || { echo "$output"; exit 1; }
[[ "$(cat build/complex/complex.aleo)" == "primary artifact sentinel" ]] || exit 1
echo "Rejected transitive alias; primary artifact is unchanged."
cp "$probe/program.json" program.json
cp "$probe/build/complex/complex.aleo" build/complex/complex.aleo

printf 'outside sentinel\n' > "$probe/escaped.aleo"
printf 'outside sentinel\n' > escaped.aleo
for name in "$probe/escaped.aleo" ../escaped.aleo; do
    printf '{"program":"complex.aleo","version":"0.1.0","description":"","license":"MIT","dependencies":[{"name":"%s","location":"local","path":"simple.aleo"}]}\n' "$name" > program.json
    if output=$(${LEO_BIN} --disable-update-check build 2>&1); then
        echo "Build accepted a dependency path as its name"
        exit 1
    fi
    [[ "$output" == *"invalid dependency"* ]] || { echo "$output"; exit 1; }
    [[ "$(cat "$probe/escaped.aleo")" == "outside sentinel" && "$(cat escaped.aleo)" == "outside sentinel" ]] || exit 1
    diff -r "$probe/build" build || exit 1
    echo "Rejected dependency path; outside files and build artifacts are unchanged."
done
printf '{"program":"complex.aleo","version":"0.1.0","description":"","license":"MIT","dependencies":[{"name":"different.aleo","location":"local","path":"simple.aleo"}]}\n' > program.json
if output=$(${LEO_BIN} --disable-update-check build 2>&1); then
    echo "Build accepted bytecode with a different program ID"
    exit 1
fi
[[ "$output" == *'Expected program `different.aleo`, but the bytecode declares `simple.aleo`.'* ]] || { echo "$output"; exit 1; }
diff -r "$probe/build" build || exit 1
echo "Rejected mismatched bytecode; build artifacts are unchanged."
cp "$probe/program.json" program.json
rm -f escaped.aleo
rm -rf "$probe"
trap - EXIT

outside=$(mktemp -d)
mv build build.saved
trap 'rm -rf build "$outside"; mv build.saved build' EXIT

for target in root directory file dangling; do
    mkdir -p "$outside/simple"
    printf 'sentinel\n' > "$outside/simple/simple.aleo"
    case "$target" in
        root) ln -s "$outside" build ;;
        directory) mkdir build; ln -s "$outside/simple" build/simple ;;
        file) mkdir -p build/simple; ln -s "$outside/simple/simple.aleo" build/simple/simple.aleo ;;
        dangling) mkdir -p build/simple; ln -s "$outside/missing.aleo" build/simple/simple.aleo ;;
    esac
    if output=$(${LEO_BIN} --disable-update-check build 2>&1); then
        echo "Build accepted a $target symlink"
        exit 1
    fi
    [[ "$output" == *"Build output must not contain symlinks"* ]] || { echo "$output"; exit 1; }
    [[ "$(cat "$outside/simple/simple.aleo")" == "sentinel" && ! -e "$outside/missing.aleo" ]] || exit 1
    echo "Rejected $target symlink; outside files are unchanged."
    rm -rf build
done
