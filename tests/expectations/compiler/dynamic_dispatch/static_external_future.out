program token_registry.aleo;

record Token:
    owner as address.private;
    amount as u128.private;
    metadata as field.private;

function burn_private:
    input r0 as Token.record;
    input r1 as u128.private;
    sub r0.amount r1 into r2;
    cast r0.owner r2 r0.metadata into r3 as Token.record;
    async burn_private into r4;
    output r3 as Token.record;
    output r4 as token_registry.aleo/burn_private.future;

finalize burn_private:
    assert.eq 1u8 1u8;

function consume_private:
    input r0 as Token.record;
    cast r0.amount into r1 as u64;
    output r1 as u64.private;

function refresh:
    input r0 as Token.record;
    cast r0.owner r0.amount r0.metadata into r1 as Token.record;
    output r1 as Token.record;

constructor:
    assert.eq edition 0u16;
// --- Next Program --- //
program credits.aleo;

record credits:
    owner as address.private;
    amount as u64.private;

function transfer_public_to_private:
    input r0 as address.private;
    input r1 as u64.private;
    cast r0 r1 into r2 as credits.record;
    async transfer_public_to_private into r3;
    output r2 as credits.record;
    output r3 as credits.aleo/transfer_public_to_private.future;

finalize transfer_public_to_private:
    assert.eq 1u8 1u8;

constructor:
    assert.eq edition 0u16;
// --- Next Program --- //
import credits.aleo;
