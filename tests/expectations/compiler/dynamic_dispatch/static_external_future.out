program token_registry.aleo;

record Token:
    owner as address.private;
    amount as u128.private;
    metadata as field.private;

record Permission:
    owner as address.private;
    allowed as boolean.private;

struct Metadata:
    recipient as address;
    amount as u64;

function burn_private:
    input r0 as Token.record;
    input r1 as u128.private;
    sub r0.amount r1 into r2;
    cast r0.owner r2 r0.metadata into r3 as Token.record;
    async burn_private into r4;
    output r3 as Token.record;
    output r4 as token_registry.aleo/burn_private.future;

finalize burn_private:
    assert.eq 1u8 1u8;

constructor:
    assert.eq edition 0u16;
// --- Next Program --- //
program credits.aleo;

record credits:
    owner as address.private;
    amount as u64.private;

function transfer_public_to_private:
    input r0 as address.private;
    input r1 as u64.private;
    cast r0 r1 into r2 as credits.record;
    async transfer_public_to_private into r3;
    output r2 as credits.record;
    output r3 as credits.aleo/transfer_public_to_private.future;

finalize transfer_public_to_private:
    assert.eq 1u8 1u8;

constructor:
    assert.eq edition 0u16;
// --- Next Program --- //
import credits.aleo;
import token_registry.aleo;
program test_static.aleo;

record LocalReceipt:
    owner as address.private;
    amount as u64.private;

function test_withdraw_private:
    input r0 as u64.private;
    call credits.aleo/transfer_public_to_private self.signer r0 into r1 r2;
    async test_withdraw_private r2 into r3;
    output r1 as credits.aleo/credits.record;
    output r3 as test_static.aleo/test_withdraw_private.future;

finalize test_withdraw_private:
    input r0 as credits.aleo/transfer_public_to_private.future;
    await r0;

function direct_record_conversion:
    input r0 as token_registry.aleo/Token.record;
    input r1 as u64.private;
    call credits.aleo/transfer_public_to_private r0.owner r1 into r2 r3;
    cast r1 into r4 as u128;
    call token_registry.aleo/burn_private r0 r4 into r5 r6;
    async direct_record_conversion r3 r6 into r7;
    output r5 as token_registry.aleo/Token.record;
    output r2 as credits.aleo/credits.record;
    output r7 as test_static.aleo/direct_record_conversion.future;

finalize direct_record_conversion:
    input r0 as credits.aleo/transfer_public_to_private.future;
    input r1 as token_registry.aleo/burn_private.future;
    await r0;
    await r1;

function asserted_record_conversion:
    input r0 as token_registry.aleo/Token.record;
    input r1 as u64.private;
    assert.eq r0.metadata 0field;
    call credits.aleo/transfer_public_to_private r0.owner r1 into r2 r3;
    cast r1 into r4 as u128;
    call token_registry.aleo/burn_private r0 r4 into r5 r6;
    async asserted_record_conversion r3 r6 into r7;
    output r5 as token_registry.aleo/Token.record;
    output r2 as credits.aleo/credits.record;
    output r7 as test_static.aleo/asserted_record_conversion.future;

finalize asserted_record_conversion:
    input r0 as credits.aleo/transfer_public_to_private.future;
    input r1 as token_registry.aleo/burn_private.future;
    await r0;
    await r1;

function dynamic_record_output:
    input r0 as token_registry.aleo/Token.record;
    input r1 as u64.private;
    input r2 as field.private;
    input r3 as field.private;
    input r4 as field.private;
    call.dynamic r2 r3 r4 with r1 (as u64.private) into r5 (as dynamic.record);
    cast r1 into r6 as u128;
    call token_registry.aleo/burn_private r0 r6 into r7 r8;
    async dynamic_record_output r8 into r9;
    output r7 as token_registry.aleo/Token.record;
    output r5 as dynamic.record;
    output r9 as test_static.aleo/dynamic_record_output.future;

finalize dynamic_record_output:
    input r0 as token_registry.aleo/burn_private.future;
    await r0;

function local_record_output:
    input r0 as token_registry.aleo/Token.record;
    input r1 as u64.private;
    cast r0.owner r1 into r2 as LocalReceipt.record;
    output r0 as token_registry.aleo/Token.record;
    output r2 as LocalReceipt.record;

function external_output_no_consumption:
    input r0 as token_registry.aleo/Token.record;
    input r1 as u64.private;
    call credits.aleo/transfer_public_to_private r0.owner r1 into r2 r3;
    async external_output_no_consumption r3 into r4;
    output r0 as token_registry.aleo/Token.record;
    output r2 as credits.aleo/credits.record;
    output r4 as test_static.aleo/external_output_no_consumption.future;

finalize external_output_no_consumption:
    input r0 as credits.aleo/transfer_public_to_private.future;
    await r0;

function multiple_inputs_local_output:
    input r0 as token_registry.aleo/Token.record;
    input r1 as token_registry.aleo/Token.record;
    add r0.amount r1.amount into r2;
    cast r2 into r3 as u64;
    cast r0.owner r3 into r4 as LocalReceipt.record;
    output r0 as token_registry.aleo/Token.record;
    output r1 as token_registry.aleo/Token.record;
    output r4 as LocalReceipt.record;

function mixed_record_origins:
    input r0 as token_registry.aleo/Token.record;
    input r1 as credits.aleo/credits.record;
    cast r0.amount into r2 as u64;
    cast r1.owner r2 into r3 as LocalReceipt.record;
    output r0 as token_registry.aleo/Token.record;
    output r1 as credits.aleo/credits.record;
    output r3 as LocalReceipt.record;

function same_program_records:
    input r0 as token_registry.aleo/Token.record;
    input r1 as token_registry.aleo/Permission.record;
    output r0 as token_registry.aleo/Token.record;
    output r1 as token_registry.aleo/Permission.record;

function permission_local_output:
    input r0 as token_registry.aleo/Permission.record;
    cast r0.owner 0u64 into r1 as LocalReceipt.record;
    output r0 as token_registry.aleo/Permission.record;
    output r1 as LocalReceipt.record;

function local_input_external_output:
    input r0 as LocalReceipt.record;
    call credits.aleo/transfer_public_to_private r0.owner r0.amount into r1 r2;
    async local_input_external_output r2 into r3;
    output r1 as credits.aleo/credits.record;
    output r3 as test_static.aleo/local_input_external_output.future;

finalize local_input_external_output:
    input r0 as credits.aleo/transfer_public_to_private.future;
    await r0;

function external_struct_input:
    input r0 as token_registry.aleo/Metadata.private;
    cast r0.recipient r0.amount into r1 as LocalReceipt.record;
    output r1 as LocalReceipt.record;

function external_struct_output:
    input r0 as credits.aleo/credits.record;
    cast r0.owner 0u64 into r1 as token_registry.aleo/Metadata;
    output r1 as token_registry.aleo/Metadata.private;

function mixed_dynamic_origins:
    input r0 as token_registry.aleo/Token.record;
    input r1 as dynamic.record;
    input r2 as LocalReceipt.record;
    cast r2.owner r2.amount into r3 as LocalReceipt.record;
    output r0 as token_registry.aleo/Token.record;
    output r1 as dynamic.record;
    output r3 as LocalReceipt.record;

function dynamic_input_concrete_output:
    input r0 as dynamic.record;
    input r1 as LocalReceipt.record;
    cast r1.owner r1.amount into r2 as LocalReceipt.record;
    output r0 as dynamic.record;
    output r2 as LocalReceipt.record;

function record_input_scalar_output:
    input r0 as token_registry.aleo/Token.record;
    output r0.amount as u128.private;

constructor:
    assert.eq edition 0u16;
