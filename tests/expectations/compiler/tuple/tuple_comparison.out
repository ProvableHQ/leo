program tuple_eq_flat_stress.aleo;

struct S:
    a as u32;
    b as u32;

closure make_pair:
    input r0 as u32;
    input r1 as u32;
    assert.eq true true;
    output r0 as u32;
    output r1 as u32;

closure make_triple:
    input r0 as u32;
    input r1 as u32;
    input r2 as u32;
    assert.eq true true;
    output r0 as u32;
    output r1 as u32;
    output r2 as u32;

function test_all:
    call make_pair 10u32 20u32 into r0 r1;
    call make_pair 10u32 30u32 into r2 r3;
    assert.eq r0 r0;
    assert.eq r1 r1;
    is.neq r0 r2 into r4;
    is.neq r1 r3 into r5;
    or r4 r5 into r6;
    assert.eq r6 true;
    is.eq r0 r2 into r7;
    is.eq r1 r3 into r8;
    and r7 r8 into r9;
    is.eq r9 false into r10;
    assert.eq r10 true;
    call make_triple 1u32 2u32 3u32 into r11 r12 r13;
    call make_triple 1u32 4u32 3u32 into r14 r15 r16;
    assert.eq r11 r11;
    assert.eq r12 r12;
    assert.eq r13 r13;
    is.neq r11 r14 into r17;
    is.neq r12 r15 into r18;
    or r17 r18 into r19;
    is.neq r13 r16 into r20;
    or r19 r20 into r21;
    assert.eq r21 true;
    is.eq r11 r14 into r22;
    is.eq r12 r15 into r23;
    and r22 r23 into r24;
    is.eq r13 r16 into r25;
    and r24 r25 into r26;
    is.eq r26 false into r27;
    assert.eq r27 true;

constructor:
    assert.eq edition 0u16;
