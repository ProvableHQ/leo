program test.aleo;

mapping foo:
    key as u8.public;
    value as u8.public;

function food:

constructor:
    get foo[0u8] into r0;
    assert.eq r0 0u8;
    assert.neq edition 1u16;
// --- Next Program --- //
import test.aleo;
program child.aleo;

function main:

constructor:
    assert.neq edition 2u16;
// --- Next Program --- //
import child.aleo;
import test.aleo;
program parent.aleo;

function main:

constructor:
    assert.eq edition 0u16;


---
Note: Treating dependencies as Aleo produces different results:

